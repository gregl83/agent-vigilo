---
config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
flowchart TD
    Start([vigilo run cancel])

    RunId{Run id valid?}
    LockRun[Lock run for cancellation]
    Found{Run exists?}
    Status{Run status?}
    LoadCancelled[Load cancelled run snapshot]
    CancelWork[Cancel open attempts, executions, and chunks]
    UpdateRun[Mark run cancelled]
    Event[Enqueue cancellation event]
    Payload[Build cancellation payload]

    Success([Success response])

    RunIdFail([Run id error])
    NotFoundFail([Run not found error])
    TerminalFail([Cancellation error])
    UnsupportedFail([Unsupported status error])
    PersistenceFail([Persistence error])
    OutputFail([Output write error])

    Start --> RunId

    RunId -- No --> RunIdFail
    RunId -- Yes --> LockRun

    LockRun --> Found
    LockRun -. Lookup fails .-> PersistenceFail

    Found -- No --> NotFoundFail
    Found -- Yes --> Status

    Status -- Completed or failed --> TerminalFail
    Status -- Already cancelled --> LoadCancelled
    Status -- Pending, running, or finalizing --> CancelWork
    Status -- Other --> UnsupportedFail

    LoadCancelled --> Payload
    LoadCancelled -. Lookup fails .-> PersistenceFail

    CancelWork --> UpdateRun
    CancelWork -. Update fails .-> PersistenceFail

    UpdateRun --> Event
    UpdateRun -. Update fails .-> PersistenceFail

    Event --> Payload
    Event -. Enqueue fails .-> PersistenceFail

    Payload --> Success
    Payload -. Write fails .-> OutputFail

    class Start command
    class Success success
    class RunId,LockRun,Found,Status,LoadCancelled,CancelWork,UpdateRun,Event,Payload system
    class RunIdFail,NotFoundFail,TerminalFail,UnsupportedFail,PersistenceFail,OutputFail error
