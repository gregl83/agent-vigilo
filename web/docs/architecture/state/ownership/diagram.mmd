---
config:
  flowchart:
    nodeSpacing: 150
    rankSpacing: 80
  themeVariables:
    edgeLabelBackground: 'transparent'
---
flowchart TD
    CLI[CLI]
    Coordinator[Coordinator]
    Worker[Worker]
    DB[(DB guards)]
    Queue[Message broker]

    RunCreate[Persist creating run and seed plan]
    RunCancel[Cancel run and open work]
    RunRead[Read status, watch, results, export]

    RecoverCreation[Resume expired run creation]
    Dispatch[Dispatch chunk windows]
    RecoverLeases[Recover expired chunk leases]
    Finalize[Finalize terminal runs]
    Publish[Publish outbox records as broker messages]

    ChunkClaim[Claim and release chunks]
    Execute[Allocate attempts, schedule retries, and persist results]
    CompleteChunk[Complete chunks]

    GuardCreation[Creation ledger and coordinator lease]
    GuardRun[Run status and lifecycle lease]
    GuardDispatch[Run-shard dispatch cursor]
    GuardChunk[Chunk status and worker lease]
    GuardAttempt[Current attempt id and attempt number]
    GuardOutbox[Outbox dedupe key and delivery claim token]

    CLI --> RunCreate
    CLI --> RunCancel
    CLI --> RunRead

    Coordinator --> RecoverCreation
    Coordinator --> Dispatch
    Coordinator --> RecoverLeases
    Coordinator --> Finalize
    Coordinator --> Publish

    Worker --> ChunkClaim
    Worker --> Execute
    Worker --> CompleteChunk

    RunCreate --> DB
    RunCancel --> DB
    RecoverCreation --> GuardCreation
    Dispatch --> GuardDispatch
    Dispatch --> GuardRun
    RecoverLeases --> GuardChunk
    Finalize --> GuardRun
    Publish --> GuardOutbox
    ChunkClaim --> GuardChunk
    CompleteChunk --> GuardChunk
    Execute --> GuardRun
    Execute --> GuardAttempt

    GuardCreation --> DB
    GuardRun --> DB
    GuardDispatch --> DB
    GuardChunk --> DB
    GuardAttempt --> DB
    GuardOutbox --> DB
    Publish --> Queue

    class CLI command
    class Coordinator,Worker,GuardCreation,GuardRun,GuardDispatch,GuardChunk,GuardAttempt,GuardOutbox system
    class RunCreate,RunCancel,RunRead,RecoverCreation,Dispatch,RecoverLeases,Finalize,Publish,ChunkClaim,Execute,CompleteChunk component
    class DB success
    class Queue external
