    %% actors
    User(["fa:fa-user <br/> <b>AI Engineer</b> <br/> <small>[Person]</small>"]):::person
    AgentClient(["fa:fa-robot <br/> <b>Agentic Client</b> <br/> <small>[Software System]</small>"]):::actor
    CICD(["fa:fa-gears <br/> <b>CI/CD Runner</b> <br/> <small>[Software System]</small>"]):::actor

    %% main system
    AgentVigilo["fa:fa-diagram-project <br/> <b>Agent Vigilo</b> <br/> <small>[Software System]</small> <br/> <small>Orchestrates distributed evaluation runs.</small>"]:::system

    %% external target
    TargetAgent["fa:fa-brain <br/> <b>Agent / AI Provider</b> <br/> <small>[External System]</small> <br/> <small>The model, agent wrapper, or <br/> API endpoint being evaluated.</small>"]:::external

