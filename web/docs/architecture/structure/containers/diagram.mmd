---
config:
  theme: neutral
  look: handDrawn
  flowchart:
    nodeSpacing: 120
    rankSpacing: 160
  themeVariables:
    fontSize: 18px
    padding: 50
---
flowchart TD
    %% styles
    classDef actor fill:#ebe7f5,color:#5e4b8d,stroke:#5e4b8d,stroke-width:2px
    classDef person fill:#d4e5f7,color:#08427b,stroke:#08427b,stroke-width:2px
    classDef component fill:#deebf7,color:#1168bd,stroke:#1168bd,stroke-width:2px
    classDef external fill:#f9f9f9,color:#666,stroke:#666,stroke-width:2px

    %% actors
    User(["fa:fa-user <br/> <b>AI Engineer</b> <br/> <small>[Person]</small>"]):::person
    AgentClient(["fa:fa-robot <br/> <b>Agentic Client</b> <br/> <small>[Software System]</small>"]):::actor
    CICD(["fa:fa-gears <br/> <b>CI/CD Runner</b> <br/> <small>[Software System]</small>"]):::actor


    %% components
    Vigilo["fa:fa-terminal <br/> <b>Vigilo Command Runtime</b> <br/> <small>[Container: Rust]</small> <br/> <small>Provides evaluator and run management functionality via CLI.</small>"]:::component
    Coordinator["fa:fa-compass <br/> <b>Coordinator</b> <br/> <small>[Container: Rust]</small> <br/> <small>Chunks run cases, publishes work batches, tracks progress, and handles orchestration failures.</small>"]:::component
    Worker["fa:fa-gear <br/> <b>Worker</b> <br/> <small>[Container: Rust]</small> <br/> <small>Consumes work batches, prompts the target agent, runs evaluators, validates output, and persists normalized results.</small>"]:::component
    Database[("<b>Database</b> <br/> <small>[Container: PostgreSQL]</small> <br/> <small>Stores evaluators, datasets, runs, case batches, results, events, and runtime state.</small>")]:::component
    Queue[("<b>Queue</b> <br/> <small>[Container: RabbitMQ]</small> <br/> <small>Stores and distributes run dataset case batches.</small>")]:::component

    %% system boundary
    subgraph VigiloSystem["[Container] Agent Vigilo"]
        Vigilo
        Coordinator
        Worker
        Database
        Queue
    end
    style VigiloSystem fill:none,stroke:#1168bd,stroke-width:2px

    %% external target
    TargetAgent["fa:fa-brain <br/> <b>Agent / AI Provider</b> <br/> <small>[External System]</small> <br/> <small>The model, agent wrapper, or API endpoint being evaluated</small>"]:::external

    %% edges
    User & AgentClient -->|"Manages evaluators, runs and runtime services using"| Vigilo
    CICD -->|Creates runs and <br/> gates deployments via| Vigilo
    Vigilo -->|"Reads from <br/> and writes to <br> <small>[SQL/TCP]</small>"| Database
    Vigilo -->|"Starts and stops <br/> service of type"| Coordinator
    Vigilo -->|"Starts and stops <br/> service of type"| Worker
    Coordinator -->|"Reads from <br/> and writes to <br> <small>[SQL/TCP]</small>"| Database
    Coordinator -->|"Publishes run <br/> dataset case batches to <br> <small>[JSON/AMQP]</small>"| Queue
    Queue -->|"Streams run dataset case batches to <br> <small>[JSON/AMQP]</small>"| Worker
    Worker -->|"Reads from <br/> and writes to <br> <small>[SQL/TCP]</small>"| Database
    Worker -->|"Sends case prompts to and receives agent responses from <br> <small>[TEXT/HTTP]</small>"| TargetAgent
